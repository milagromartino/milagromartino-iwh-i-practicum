doctype html
html(lang="en")
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Plants
        p
            a(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Species
                    th Bio
            tbody
                each plant in data
                    tr
                        td #{plant.properties.name}
                        td #{plant.properties.species}
                        td #{plant.properties.bio}